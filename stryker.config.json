{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing of the business rules: a surviving mutant is a behaviour no test pins down. Run with npm run test:mutation.",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "tests/jest.stryker.config.ts",
    "enableFindRelatedTests": false
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "core/domain/**/*.ts",
    "core/application/**/*.usecase.ts",
    "core/application/mappers/**/*.ts",
    "core/gateways/persistence/**/*.ts",
    "!**/index.ts"
  ],
  "ignorePatterns": [
    "dist",
    "coverage",
    "reports",
    "tmp",
    ".nx",
    ".angular",
    "apps",
    "libs/chat/frameworks/ui",
    "articles"
  ],
  "tempDirName": ".stryker-tmp",
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 10000,
  "concurrency": 4
}
